---
import Layout from '../layouts/Layout.astro';
import LanguageToggle from './LanguageToggle.astro';
import strings from '../i18n/ui-strings';
import type { Lang } from '../i18n/ui-strings';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings[lang];
const altLang = lang === 'en' ? 'es' : 'en';

const skills = [
  'Python', 'PHP', 'CodeIgniter', 'PowerShell', 'Bash', 'JavaScript', 'Node.js',
  'Docker', 'Ansible', 'Git', 'AWS', 'Opencode (GLM)',
  'Linux', 'Hyper-V', 'Trivy', 'Windows Server', 'MySQL', 'SQL',
  'Networking (DHCP, DNS)'
];
---

<Layout title="Emmanuel Martin — Automation Engineer" lang={lang}>
  <div class="container">
    <section class="hero" id="home">
      <div class="hero-top">
        <div class="terminal-line">$ whoami</div>
        <LanguageToggle lang={altLang} />
      </div>
      <h1>Emmanuel Martin</h1>
      <p class="subtitle">{t.subtitle}</p>
      <div class="hero-contact-links">
        <a href="https://github.com/emmanuelmartindavid" target="_blank" rel="noopener noreferrer" class="hero-contact-link" aria-label="GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          <span>/emmanuelmartindavid</span>
        </a>
        <a href="https://www.linkedin.com/in/emmanuel-martind/" target="_blank" rel="noopener noreferrer" class="hero-contact-link" aria-label="LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
          <span>/in/emmanuel-martind</span>
        </a>
        <a href="mailto:emmanuelmartindavid1@gmail.com" class="hero-contact-link" aria-label="Email">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <span>emmanuelmartindavid1@gmail.com</span>
        </a>
      </div>
      <p class="hero-location">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        <span>{t.location}</span>
      </p>
      <p class="about">
        {t.about}
        <span class="cursor"></span>
      </p>
    </section>

    <section class="section" id="skills">
      <h2 class="section-title">{t.sections.skills}</h2>
      <div class="skills-grid">
        {skills.map((skill) => (
          <span class="skill-tag">{skill}</span>
        ))}
      </div>
    </section>

    <section class="section" id="experience">
      <h2 class="section-title">{t.sections.experience}</h2>
      {t.experience.map((exp) => (
        <div class="experience-item">
          <div class="experience-header">
            <h3>{exp.title}</h3>
            <p class="company">{exp.company}</p>
            <p class="date">{exp.date}</p>
          </div>
          <ul class="experience-highlights">
            {exp.bullets.map((bullet) => (
              <li set:html={bullet} />
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="section" id="projects">
      <h2 class="section-title">{t.sections.projects}</h2>
      <div class="projects-grid">
        {t.projects.map((project) => (
          <div class="project-card">
            <h3>{project.name}</h3>
            <p>{project.description}</p>
            <a href={project.url} target="_blank" rel="noopener noreferrer" class="project-link">
              &#8594; {t.viewProject}
            </a>
          </div>
        ))}
      </div>
    </section>

    <footer class="footer">
      <p>&copy; {new Date().getFullYear()} Emmanuel Martin. {t.footer}</p>
    </footer>
  </div>
</Layout>
